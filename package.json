{
  "name": "sherwood-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "compile:native20": "node scripts/compile-native20.mjs",
    "pretest": "node scripts/compile.mjs && node scripts/compile-native20.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "pretest:integration": "node scripts/compile.mjs && node scripts/compile-native20.mjs",
    "test:integration": "node --test --test-concurrency=1 integration/wallet-feed-site.test.mjs",
    "demo": "node scripts/demo.mjs",
    "check:platform": "node scripts/check-platform.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "prepare:payout": "node scripts/prepare-payout.mjs",
    "estimate:gas": "node scripts/estimate-launch-gas.mjs",
    "operator": "node scripts/operator.mjs",
    "executor:local": "node scripts/executor.mjs",
    "operator:production": "node scripts/production-operator.mjs",
    "wallet-feed": "node scripts/export-wallet-feed.mjs",
    "launch:prepare": "node scripts/prepare-robin-launch-plan.mjs",
    "launch:distributor": "node scripts/refresh-robin-distributor.mjs",
    "launch:api": "node scripts/robin-launch-api.mjs",
    "launch:handoff": "node scripts/prepare-launch-handoff.mjs",
    "launch:review": "node scripts/serve-robin-launch-wallet.mjs",
    "launch:watch": "node scripts/watch-launch.mjs",
    "launch:standby": "node scripts/launch-standby.mjs --loop"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@uniswap/v4-core": "1.0.2",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@uniswap/universal-router": "2.1.0",
    "hardhat": "2.26.3",
    "solc": "0.8.26"
  }
}
